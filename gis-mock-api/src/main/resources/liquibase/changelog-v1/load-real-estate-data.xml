<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="load-real-estate-csv-data" author="dev">
        <loadData file="classpath:liquibase/data/v1/data.csv" tableName="real_estate">

            <!-- Basic Identifiers -->
            <column name="id" header="ID" type="STRING"/>
            <column name="mls_number" header="MLS_Number" type="STRING"/>
            <column name="tax_id" header="Tax ID" type="STRING"/>
            <column name="address" header="Address" type="STRING"/>
            <column name="city" header="City" type="STRING"/>
            <column name="state" header="State" type="STRING"/>
            <column name="zip" header="Zip" type="STRING"/>
            <column name="status" header="Status" type="STRING"/>

            <!-- Sales and Listing Information -->
            <column name="short_sale" header="Short Sale" type="STRING"/>
            <column name="time_uc" header="Time UC" type="STRING"/>
            <column name="dom" header="DOM" type="INTEGER"/>
            <column name="sold_date" header="Sold Date" type="DATE"/>
            <column name="sold_terms" header="Sold Terms" type="STRING"/>
            <column name="sold_price" header="Sold Price" type="STRING"/>
            <column name="sold_concessions" header="Sold Concessions" type="STRING"/>
            <column name="list_price" header="List Price" type="STRING"/>
            <column name="original_list_price" header="Original List Price" type="STRING"/>
            <column name="under_contract_date" header="Under Contract Date" type="DATE"/>
            <column name="entry_date" header="Entry Date" type="DATE"/>
            <column name="effective_date_of_listing_agreement" header="Effective Date Of The Listing Agreement" type="DATE"/>
            <column name="status_change_date" header="Status Change Date" type="DATE"/>
            <column name="off_market_date" header="Off Market Date" type="DATE"/>
            <column name="reinstated_date" header="Reinstated Date" type="DATE"/>
            <column name="cancel_date" header="Cancel Date" type="DATE"/>
            <column name="offer_under_3rd_party_review" header="Offer Under 3rd Party Review" type="STRING"/>
            <column name="price_increase_date" header="Price Increase Date" type="DATE"/>
            <column name="price_increase_days_back" header="Price Increase Days Back" type="INTEGER"/>
            <column name="price_reduction_date" header="Price Reduction Date" type="DATE"/>
            <column name="price_reduction_days_back" header="Price Reduction Days Back" type="INTEGER"/>
            <column name="backup_status_date" header="Backup Status Date" type="DATE"/>
            <column name="withdrawal_date" header="Withdrawal Date" type="DATE"/>
            <column name="expire_date" header="Expire Date" type="DATE"/>

            <!-- Property Details -->
            <column name="acres" header="Acres" type="NUMERIC"/>
            <column name="property_type" header="Property Type" type="STRING"/>
            <column name="style" header="Style" type="STRING"/>
            <column name="year_built" header="Year Built" type="INTEGER"/>
            <column name="gross_living_area_gla" header="Gross Living Area (GLA)" type="INTEGER"/>
            <column name="total_square_feet" header="Total Square Feet" type="INTEGER"/>
            <column name="total_bedrooms" header="Total Bedrooms" type="INTEGER"/>
            <column name="total_bathrooms" header="Total Bathrooms" type="INTEGER"/>
            <column name="total_full_bathrooms" header="Total Full Bathrooms" type="INTEGER"/>
            <column name="total_three_quarter_bathrooms" header="Total Three-quarter Bathrooms" type="INTEGER"/>
            <column name="total_half_bathrooms" header="Total Half Bathrooms" type="INTEGER"/>
            <column name="total_kitchens" header="Total Kitchens" type="INTEGER"/>
            <column name="basement_square_feet" header="Basement Square Feet" type="INTEGER"/>
            <column name="basement_finished" header="Basement Finished" type="INTEGER"/>
            <column name="basement_bedrooms" header="Basement Bedrooms" type="INTEGER"/>
            <column name="basement_full_bathrooms" header="Basement Full Bathrooms" type="INTEGER"/>
            <column name="basement_three_quarter_bathrooms" header="Basement Three-quarter Bathrooms" type="INTEGER"/>
            <column name="basement_half_bathrooms" header="Basement Half Bathrooms" type="INTEGER"/>
            <column name="basement" header="Basement" type="STRING"/>

            <!-- Features and Amenities -->
            <column name="heating" header="Heating" type="STRING"/>
            <column name="air_conditioning" header="Air Conditioning" type="STRING"/>
            <column name="garage_capacity" header="Garage Capacity" type="INTEGER"/>
            <column name="carport_capacity" header="Carport Capacity" type="INTEGER"/>
            <column name="garage_parking" header="Garage/Parking" type="STRING"/>
            <column name="decks" header="Decks" type="INTEGER"/>
            <column name="solar" header="Solar?" type="BOOLEAN"/>
            <column name="solar_ownership" header="Solar Ownership" type="STRING"/>
            <column name="total_fireplaces" header="Total Fireplaces" type="INTEGER"/>
            <column name="landscape" header="Landscape" type="STRING"/>
            <column name="pool_available" header="Pool?" type="BOOLEAN"/>
            <column name="pool_details" header="Pool" type="STRING"/>
            <column name="hoa_fee" header="HOA Fee" type="STRING"/>
            <column name="hoa_amenities" header="HOA Amenities" type="STRING"/>
            <column name="hoa_remarks" header="HOA Remarks" type="STRING"/>

            <!-- Area Measurements and Extras -->
            <column name="main_floor_square_feet" header="Main Floor Square Feet" type="INTEGER"/>
            <column name="second_floor_square_feet" header="Second Floor Square Feet" type="INTEGER"/>
            <column name="third_floor_square_feet" header="Third Floor Square Feet" type="INTEGER"/>
            <column name="fourth_floor_square_feet" header="Fourth Floor Square Feet" type="INTEGER"/>
            <column name="exterior_features" header="Exterior Features" type="STRING"/>
            <column name="floor" header="Floor" type="STRING"/>
            <column name="county" header="County" type="STRING"/>
            <column name="interior_features" header="Interior Features" type="STRING"/>
            <column name="public_remarks" header="Public Remarks" type="STRING"/>
            <column name="bac_compensation" header="BAC Compensation" type="STRING"/>
            <column name="mls_link" header="MLS Link" type="STRING"/>
            <column name="quality" header="Quality" type="STRING"/>
            <column name="condition" header="Condition" type="STRING"/>
            <column name="location_positive" header="Location +" type="STRING"/>
            <column name="location_negative" header="Location -" type="STRING"/>
            <column name="view_positive" header="View +" type="STRING"/>
            <column name="view_negative" header="View -" type="STRING"/>
            <column name="adu" header="ADU" type="BOOLEAN"/>
            <column name="remod_update" header="Remod / Update" type="BOOLEAN"/>
            <column name="outbuilding" header="Outbuilding" type="BOOLEAN"/>
            <column name="full_address" header="Full Address" type="STRING"/>

            <!-- Geolocation and Legal -->
            <column name="latitude" header="Latitude" type="NUMERIC"/>
            <column name="longitude" header="Longitude" type="NUMERIC"/>
            <column name="legal" header="Legal" type="STRING"/>
            <column name="verified" header="Verified" type="BOOLEAN"/>
            <column name="legal_match_to_tax" header="LegalMatchToTax" type="BOOLEAN"/>
            <column name="county_record_link" header="CountyRecordLink" type="STRING"/>
            <column name="html_body_td" header="/html/body/table/tbody/tr/td/table/tbody/tr[4]/td[2]" type="STRING"/>

            <!-- Audit Columns -->
            <column name="created_at" header="created_at" type="TIMESTAMP"/>
            <column name="updated_at" header="updated_at" type="TIMESTAMP"/>
        </loadData>
    </changeSet>
</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="create-user-google-oauth-token-table" author="dev">
        <!-- CREATE TABLE -->
        <createTable tableName="user_google_oauth_token">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="user_id" type="VARCHAR(36)">
                <!-- Must be unique if each user can only have one Google token row -->
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="access_token" type="VARCHAR(2048)">
                <constraints nullable="false"/>
            </column>

            <column name="refresh_token" type="VARCHAR(2048)"/>
            <column name="expires_at" type="TIMESTAMP"/>
            <column name="scope" type="VARCHAR(1024)"/>

            <!-- Auditing columns from your base Model -->
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <!-- ADD FOREIGN KEY user_id -> users(id) -->
        <addForeignKeyConstraint
                baseTableName="user_google_oauth_token"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_user_google_oauth_token_user"
                onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
